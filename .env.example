SQLITE_PATH=scheduler.db
DEFAULT_REMINDER_MINUTES=15
DEFAULT_TIMEZONE=America/Bogota
RUN_WEB_APP=true
WEB_HOST=127.0.0.1
WEB_PORT=5000
FLASK_SECRET_KEY=change-me
APP_ENCRYPTION_KEY=replace-with-fernet-key
OTP_EXPIRATION_MINUTES=10
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
WHISPER_MODEL=base
TTS_PROVIDER=coqui
TTS_MODEL_NAME=tts_models/es/css10/vits
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MCP_ENABLED=true
MCP_HTTP_ENDPOINT=http://localhost:8088/mcp
MCP_TIMEOUT_SECONDS=15
MCP_RETRY_COUNT=2
MCP_GOOGLE_CALENDAR_CREATE_TOOL=google_calendar.create_event
MCP_GOOGLE_CALENDAR_UPDATE_TOOL=google_calendar.update_event
MCP_GOOGLE_CALENDAR_DELETE_TOOL=google_calendar.delete_event
MCP_LIST_TOOLS_METHOD=tools/list
MCP_LIST_TEMPLATES_METHOD=prompts/list
MCP_LIST_RESOURCES_METHOD=resources/list
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=C:\route\to\oauth-client-secrets.json
GOOGLE_OAUTH_REDIRECT_HOST=127.0.0.1
GOOGLE_OAUTH_REDIRECT_PORT=5000
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar
